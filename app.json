{
  "expo": {
    "name": "FoodLens AI",
    "slug": "foodlens-ai",
    "version": "0.1.0",
    "sdkVersion": "58.0.0",
    "scheme": "foodlens",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foodlensai.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "FoodLens AI uses your camera so you can take a photo of a meal and get an estimated nutrition breakdown.",
        "NSPhotoLibraryUsageDescription": "FoodLens AI needs access to your photos so you can pick an existing meal photo to analyze."
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.foodlensai.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#EFF6F1",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0A0A0A"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FoodLens AI needs access to your photos so you can pick an existing meal photo to analyze.",
          "cameraPermission": "FoodLens AI uses your camera so you can take a photo of a meal and get an estimated nutrition breakdown.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FoodLens AI uses your camera to scan a barcode or photograph a meal.",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d20d4355-162f-47d1-bbcf-63929014f42f"
      }
    },
    "owner": "armanvibecodingdev"
  }
}
